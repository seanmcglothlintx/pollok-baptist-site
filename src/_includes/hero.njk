{#
  Usage:
    {% set hero = {
      image: "/assets/images/x.jpg",   omit for a plain dark hero
      heading: "...",                  optional h1
      tagline: "...",                  optional line under the heading
      serviceLine: true,               optional, prints the service times from site.json
      cta: { label: "...", href: "..." },  optional button
      size: "tall" | "short"           default short
    } %}
    {% include "hero.njk" %}
#}
{% if hero.image %}
<section class="hero hero--{{ hero.size or 'short' }}" style="background-image: url('{{ hero.image | url }}')">
{% else %}
<section class="hero hero--{{ hero.size or 'short' }} hero--plain">
{% endif %}
  <div class="hero__inner">
    {% if hero.heading %}<h1 class="hero__heading">{{ hero.heading }}</h1>{% endif %}
    {% if hero.tagline %}<p class="hero__tagline">{{ hero.tagline }}</p>{% endif %}
    {% if hero.serviceLine %}
      <p class="hero__service">
        {% for s in site.serviceTimes %}<span class="hero__service-item"><span class="hero__service-label">{{ s.label }}</span> {{ s.time }}</span>{% endfor %}
      </p>
    {% endif %}
    {% if hero.cta %}<p class="hero__cta"><a class="button button--large" href="{{ hero.cta.href }}">{{ hero.cta.label }}</a></p>{% endif %}
  </div>
</section>
