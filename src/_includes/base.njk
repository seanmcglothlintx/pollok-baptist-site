<!DOCTYPE html>
<!--
  Design: Massively by HTML5 UP (html5up.net | @ajlkn), adapted for Pollok Baptist Church.
  Free for personal and commercial use under the CCA 3.0 license (html5up.net/license).
-->
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title }} - {{ site.name }}</title>
  <meta name="description" content="{{ description }}">
  <meta property="og:title" content="{{ title }} - {{ site.name }}">
  <meta property="og:description" content="{{ description }}">
  <meta property="og:type" content="website">
  <meta property="og:image" content="{{ '/assets/images/hero-church.jpg' | url }}">
  <link rel="icon" type="image/png" href="/favicon.png">
  <link rel="stylesheet" href="/assets/css/main.css">
  <link rel="stylesheet" href="/assets/css/site.css">
  <noscript><link rel="stylesheet" href="/assets/css/noscript.css"></noscript>
  <script type="application/json" id="site-config">{{ {
    basePath: "/" | url,
    timeZone: site.timeZone,
    calendar: site.calendar,
    announcements: site.announcements
  } | dump | safe }}</script>
</head>
<body class="is-preload page--{{ page.fileSlug or 'home' }}">
  <a class="skip-link" href="#main">Skip to content</a>

  <div id="wrapper"{% if intro %} class="fade-in"{% endif %}>

    {% if intro %}
    <div id="intro">
      <h1>Pollok Baptist <br>Church</h1>
      <p>{{ site.tagline }}</p>
      <p class="intro__service">
        {% for s in site.serviceTimes %}<span class="intro__service-item">{{ s.label }} &middot; {{ s.time }}</span>{% endfor %}
      </p>
      <ul class="actions">
        <li><a href="/contact/" class="button primary large">Plan your visit</a></li>
        <li><a href="#header" class="button icon solid solo fa-arrow-down scrolly">Continue</a></li>
      </ul>
    </div>
    {% endif %}

    <header id="header">
      <a href="/" class="logo">{{ site.name }}</a>
    </header>

    <nav id="nav" aria-label="Main">
      <ul class="links">
        {% set navItems = [
          { label: "Home", href: "/" },
          { label: "About", href: "/about/" },
          { label: "Events", href: "/events/" },
          { label: "Announcements", href: "/announcements/" },
          { label: "Contact", href: "/contact/" }
        ] %}
        {% for item in navItems %}
          {% if item.href == page.url %}
            <li class="active"><a href="{{ item.href }}" aria-current="page">{{ item.label }}</a></li>
          {% else %}
            <li><a href="{{ item.href }}">{{ item.label }}</a></li>
          {% endif %}
        {% endfor %}
        {% if page.url == "/give/" %}
          <li class="active"><a href="/give/" class="nav-cta" aria-current="page">Give</a></li>
        {% else %}
          <li><a href="/give/" class="nav-cta">Give</a></li>
        {% endif %}
      </ul>
      <ul class="icons">
        <li><a href="{{ site.facebookUrl }}" class="icon brands fa-facebook-f" target="_blank" rel="noopener"><span class="label">Facebook</span></a></li>
        <li><a href="{{ site.phoneHref }}" class="icon solid fa-phone"><span class="label">Call {{ site.phone }}</span></a></li>
        <li><a href="mailto:{{ site.email }}" class="icon solid fa-envelope"><span class="label">Email {{ site.email }}</span></a></li>
        <li><a href="{{ site.mapLinkUrl }}" class="icon solid fa-map-marker-alt" target="_blank" rel="noopener"><span class="label">Directions</span></a></li>
      </ul>
    </nav>

    <div id="main">
      {{ content | safe }}
    </div>

    <footer id="footer">
      <section>
        <h3>Visit us</h3>
        <p>
          {% for s in site.serviceTimes %}<strong>{{ s.label }}</strong> &middot; {{ s.time }}<br>{% endfor %}
          {{ site.location }}
        </p>
        <ul class="actions">
          <li><a href="{{ site.mapLinkUrl }}" class="button" target="_blank" rel="noopener">Get directions</a></li>
        </ul>
      </section>
      <section class="split contact">
        <section class="alt">
          <h3>Mailing address</h3>
          <p>{{ site.mailingAddress.line1 }}<br>{{ site.mailingAddress.city }}, {{ site.mailingAddress.state }} {{ site.mailingAddress.zip }}</p>
        </section>
        <section>
          <h3>Phone</h3>
          <p><a href="{{ site.phoneHref }}">{{ site.phone }}</a></p>
        </section>
        <section>
          <h3>Email</h3>
          <p><a href="mailto:{{ site.email }}">{{ site.email }}</a></p>
        </section>
        <section>
          <h3>Give</h3>
          <p><a href="/give/">Giving platforms compared</a></p>
        </section>
      </section>
    </footer>

    <div id="copyright">
      <ul><li>&copy; {{ buildYear }} {{ site.name }}</li><li>Design: <a href="https://html5up.net">HTML5 UP</a></li></ul>
    </div>

  </div>

  <script src="/assets/js/massively/jquery.min.js"></script>
  <script src="/assets/js/massively/jquery.scrollex.min.js"></script>
  <script src="/assets/js/massively/jquery.scrolly.min.js"></script>
  <script src="/assets/js/massively/browser.min.js"></script>
  <script src="/assets/js/massively/breakpoints.min.js"></script>
  <script src="/assets/js/massively/util.js"></script>
  <script src="/assets/js/massively/main.js"></script>
  <script type="module" src="/assets/js/site.js"></script>
</body>
</html>
