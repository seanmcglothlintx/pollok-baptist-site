---
layout: base.njk
title: Events
description: Upcoming services, fellowship meals, studies and special events at Pollok Baptist Church.
---
{% set hero = { image: "/assets/images/banner-gathering.jpg", heading: "Events", tagline: "What's happening at Pollok Baptist Church", size: "short" } %}
{% include "hero.njk" %}

<section class="section">
  <div class="container container--narrow">
    <h2>Upcoming Events</h2>
    <div id="events-list" class="data-mount" aria-live="polite">
      <p class="data-message data-message--loading">Loading events&hellip;</p>
    </div>
    {% if site.calendar.publicUrl %}
      <p class="text-center"><a class="button" href="{{ site.calendar.publicUrl }}" target="_blank" rel="noopener">Open in Google Calendar</a></p>
    {% endif %}
  </div>
</section>
