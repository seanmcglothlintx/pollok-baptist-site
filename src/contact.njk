---
layout: base.njk
title: Contact
description: Get in touch with Pollok Baptist Church. Address, phone, email, directions and a contact form.
---
{% set post = { heading: "Get in touch", tagline: "Contact us if you have any questions", image: "/assets/images/contact-tiles.jpg", imageAlt: "Letter tiles spelling Contact" } %}
{% include "post-header.njk" %}

  <ul class="contact-cards">
    <li class="contact-card">
      <h3>Mailing address</h3>
      <p>{{ site.mailingAddress.line1 }}<br>{{ site.mailingAddress.city }}, {{ site.mailingAddress.state }} {{ site.mailingAddress.zip }}</p>
    </li>
    <li class="contact-card">
      <h3>Phone</h3>
      <p><a href="{{ site.phoneHref }}">{{ site.phone }}</a></p>
    </li>
    <li class="contact-card">
      <h3>Email</h3>
      <p><a href="mailto:{{ site.email }}">{{ site.email }}</a></p>
    </li>
  </ul>
</section>

<section>
  <div class="row gtr-uniform">
    <div class="col-6 col-12-medium">
      <h2>Send us a message</h2>
      <form class="contact-form" action="https://formspree.io/f/{{ site.contactForm.formspreeId }}" method="POST">
        <div class="fields">
          <div class="field">
            <label for="cf-name">Name</label>
            <input id="cf-name" name="name" type="text" required autocomplete="name">
          </div>
          <div class="field">
            <label for="cf-email">Email</label>
            <input id="cf-email" name="email" type="email" required autocomplete="email">
          </div>
          <div class="field">
            <label for="cf-message">Message</label>
            <textarea id="cf-message" name="message" rows="6" required></textarea>
          </div>
        </div>
        <input type="text" name="_gotcha" class="visually-hidden" tabindex="-1" autocomplete="off" aria-hidden="true">
        <ul class="actions">
          <li><input type="submit" class="primary" value="Send message"></li>
        </ul>
      </form>
    </div>
    <div class="col-6 col-12-medium">
      <h2>Find us</h2>
      <p>{{ site.location }}</p>
      <ul class="service-times">
        {% for s in site.serviceTimes %}
          <li><strong>{{ s.label }}</strong> &middot; {{ s.time }}</li>
        {% endfor %}
      </ul>
      <div class="map-embed">
        <iframe src="{{ site.mapEmbedUrl }}" title="Map to Pollok Baptist Church" loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
      </div>
      <ul class="actions">
        <li><a class="button" href="{{ site.mapLinkUrl }}" target="_blank" rel="noopener">Get directions</a></li>
      </ul>
    </div>
  </div>
</section>
